    "palette": {
        "bg": "#000000",
        "danger": "#ff6b6b",
        "info": "#7aa2f7",
        "panel": "#2a2a2c",
        "success": "#8fbf9f",
        "surface": "#171719",
        "surfaceRaised": "#242426",
        "text": "#ececec",
        "warning": "#e5c07b"
