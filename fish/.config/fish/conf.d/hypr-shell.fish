# Цвета из токенов hypr-shell, только внутри сессии Hyprland (в niri остаётся прежняя тема).
if set -q HYPRLAND_INSTANCE_SIGNATURE; and test -f ~/.local/state/hypr-shell/apps/colors.fish
    source ~/.local/state/hypr-shell/apps/colors.fish
end

# fastfetch: compact palette-colored layout from hs-apps (the user's own ~/.config/fastfetch stays untouched).
if set -q HYPRLAND_INSTANCE_SIGNATURE; and test -f ~/.local/state/hypr-shell/apps/fastfetch.jsonc
    function fastfetch --wraps fastfetch
        command fastfetch -c ~/.local/state/hypr-shell/apps/fastfetch.jsonc $argv
    end
end

# Starship prompt; ~/.config/starship.toml is generated by hs-apps from the palette.
if status is-interactive; and command -q starship
    starship init fish | source
end
