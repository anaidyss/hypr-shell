CURSORS = {"dark": "Bibata-Modern-Ice", "light": "Bibata-Modern-Classic"}


def cursor_dir(name):
    for base in (f"{HOME}/.local/share/icons", f"{HOME}/.icons", "/usr/share/icons"):
        if os.path.isdir(f"{base}/{name}/cursors"):
            return base
    return None


def cursor():
    """Cursor follows the scheme: white Bibata on dark, black on light. Hyprland switches live (clients on the
    cursor-shape protocol follow at once); GTK reads gsettings; XWayland apps read the default theme or XCURSOR_THEME
    at start, so they pick up a change on their next launch."""
    cur = cfg.get("cursor", {})
    name = cur.get(scheme) or CURSORS[scheme]
    size = int(cur.get("size", 24))
    if cur.get("style", "accent") == "accent":
        # Whole cursor in the wallpaper accent: body = primary, edge and spinner disc = its contrast color, spinner
        # segments = accent shades. Built by hs-cursor from the Bibata sources; the name carries the colors, so a new
        # accent is a new theme (Hyprland and apps cache themes by name). Old builds are removed, the previous kept.
        spin = [accent, lift(accent, 0.45), mix(accent, accent_text, 0.3), lift(accent, 0.8)]
        args = [accent, accent_text, accent_text, ",".join(spin)]
        key = "".join(a.lstrip("#").lower() for a in args).replace(",", "")
        built = f"HS-Cursor-{hashlib.sha1(key.encode()).hexdigest()[:8]}"
        icons = f"{HOME}/.local/share/icons"
        if not os.path.isdir(f"{icons}/{built}/cursors"):
            r = subprocess.run(["hs-cursor", built, *args], capture_output=True, text=True)
            if r.returncode != 0:
                print(f"hs-apps: hs-cursor failed: {r.stderr.strip()}", file=sys.stderr)
                built = None
        if built:
            previous = (read_text(f"{OUT}/cursor") or "").split()
            keep = {built, previous[0] if previous else ""}
            for old in glob.glob(f"{icons}/HS-Cursor-*"):
                if os.path.basename(old) not in keep:
                    shutil.rmtree(old, ignore_errors=True)
            name = built
    if not cursor_dir(name):
        print(f"hs-apps: cursor theme {name} is not installed (./install.sh fetches it)", file=sys.stderr)
        return False
    changed = write(f"{OUT}/cursor", f"{name} {size}\n")
    write(f"{HOME}/.local/share/icons/default/index.theme",
          f"[Icon Theme]\nName=Default\nComment=Set by hypr-shell (hs-apps)\nInherits={name}\n")
    if shutil.which("gsettings"):
        schema = "org.gnome.desktop.interface"
        subprocess.run(["gsettings", "set", schema, "cursor-theme", name], check=False)
        subprocess.run(["gsettings", "set", schema, "cursor-size", str(size)], check=False)
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        subprocess.run(["hyprctl", "setcursor", name, str(size)], capture_output=True, check=False)
        # Apps started by systemd or D-Bus activation take the environment from there, not from Hyprland.
        env = [f"XCURSOR_THEME={name}", f"XCURSOR_SIZE={size}", f"HYPRCURSOR_THEME={name}", f"HYPRCURSOR_SIZE={size}"]
        subprocess.run(["systemctl", "--user", "set-environment", *env], capture_output=True, check=False)
        if shutil.which("dbus-update-activation-environment"):
            subprocess.run(["dbus-update-activation-environment", *env], capture_output=True, check=False)
    return changed


def gtk_switch(on):
    """on: keep the previous gtk.css aside and make ours the only user stylesheet; off: put the previous one back."""
    line = '@import url("hypr-shell.css");'
    block = f"{MARK_BEGIN}\n{line}\n{MARK_END}\n"
    for v in ("3.0", "4.0"):
        path = f"{HOME}/.config/gtk-{v}/gtk.css"
        aside = f"{path}.pre-hypr-shell"
        css = read_text(path) or ""
        css = re.sub(re.escape(MARK_BEGIN) + r".*?" + re.escape(MARK_END) + r"\n?", "", css, flags=re.S)
        if on:
            if css.strip() and not os.path.exists(aside):
                write(aside, css)
            write(path, block)
        else:
            previous = read_text(aside)
            write(path, previous if previous is not None else css)
            if previous is not None:
                os.remove(aside)
        print(f"gtk-{v}: {'enabled' if on else 'disabled'}")


if len(sys.argv) >= 3 and sys.argv[1] == "gtk" and sys.argv[2] in ("on", "off"):
    gtk()
    gtk_switch(sys.argv[2] == "on")
    sys.exit(0)

if len(sys.argv) >= 3 and sys.argv[1] == "telegram" and sys.argv[2] == "apply":
    telegram()
    telegram_apply()
    sys.exit(0)

JOBS = {
    "kitty": kitty, "gtk": gtk, "qt": qt, "fish": fish, "starship": starship, "fastfetch": fastfetch, "hyprlock": hyprlock,
    "firefox": firefox, "telegram": telegram, "spotify": spotify, "obsidian": obsidian,
    "vscode": vscode, "btop": btop, "mpv": mpv, "cursor": cursor,
}
disabled = set(cfg.get("apps", {}).get("disabled", []))
wanted = [a for a in sys.argv[1:] if a in JOBS] or [j for j in JOBS if j not in disabled]
changed = {}
for job in wanted:
    try:
        changed[job] = JOBS[job]()
    except Exception as e:  # one broken app must not stop the others
        print(f"hs-apps: {job} failed: {e}", file=sys.stderr)

if changed.get("kitty") and os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
    subprocess.run(["pkill", "-USR1", "-x", "kitty"], check=False)

if changed.get("telegram") and cfg.get("apps", {}).get("telegramAutoApply") and subprocess.run(["pgrep", "-x", "Telegram"], capture_output=True).returncode == 0:
    telegram_apply()

if "gtk" in changed and shutil.which("gsettings"):
    # The color scheme and the adw-gtk3 variant follow the shell, otherwise GTK draws its own dark widgets under our
    # light colors (or the reverse) and text disappears. A theme other than adw-gtk3 is the user's and stays.
    schema = "org.gnome.desktop.interface"

    def gget(key):
        return subprocess.run(["gsettings", "get", schema, key], capture_output=True, text=True).stdout.strip().strip("'")

    want = "prefer-light" if light else "prefer-dark"
    theme = gget("gtk-theme")
    if theme in ("adw-gtk3", "adw-gtk3-dark"):
        new_theme = "adw-gtk3" if light else "adw-gtk3-dark"
        if new_theme != theme:
            subprocess.run(["gsettings", "set", schema, "gtk-theme", new_theme], check=False)
    cur = gget("color-scheme")
    if cur and cur != want:
        subprocess.run(["gsettings", "set", schema, "color-scheme", want], check=False)
    elif cur and changed.get("gtk") and os.environ.get("WAYLAND_DISPLAY"):
        # Running GTK apps only re-read gtk.css when the color scheme setting flips, so flip it and put it back.
        subprocess.run(["gsettings", "set", schema, "color-scheme", "default"], check=False)
        subprocess.run(["gsettings", "set", schema, "color-scheme", cur], check=False)
