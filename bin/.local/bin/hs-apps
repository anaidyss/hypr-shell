    body += "".join(f'theme[{k}]="{v}"\n' for k, v in t.items())
    changed = write(f"{cfgdir}/themes/hypr-shell.theme", body)
    conf = read_text(f"{cfgdir}/btop.conf")
    if conf is not None:
        new = re.sub(r'^color_theme\s*=.*$', 'color_theme = "hypr-shell"', conf, flags=re.M)
        new = re.sub(r'^rounded_corners\s*=.*$', "rounded_corners = true", new, flags=re.M)
        changed |= write(f"{cfgdir}/btop.conf", new)
    if changed:
        subprocess.run(["pkill", "-USR2", "-x", "btop"], check=False)
    return changed


