#!/usr/bin/env python3
"""Touchpad edge sliders: left edge sets brightness, right edge sets volume.

The TOPS0102 haptic touchpad (35CC:0104) recognises slides along its side edges in
firmware and reports each detent (the click you feel) as vendor report 0x0e on hidraw:
    0e <edge> <dir> 00 ...   edge: 03 left, 04 right; dir: 01 up, 02 down
Libinput ignores that report, so we read hidraw directly (udev grants access with uaccess,
see system/70-hypr-shell-touchpad-edge.rules). Ticks that arrive while a command is still
running are summed into one step, so a fast slide never queues up.
"""
import glob, os, select, subprocess, sys, time

HID_ID = os.environ.get("HS_EDGE_HID_ID", "0018:000035CC:00000104")
REPORT, LEFT, RIGHT, UP, DOWN = 0x0E, 0x03, 0x04, 0x01, 0x02
BRIGHTNESS_STEP = 2  # percent per detent
VOLUME_STEP = 5


def find_node():
    for dev in glob.glob("/sys/class/hidraw/hidraw*"):
        try:
            with open(f"{dev}/device/uevent") as f:
                if f"HID_ID={HID_ID}" in f.read():
                    return "/dev/" + os.path.basename(dev)
        except OSError:
            pass
    return None


def brightness(ticks):
    sign = "+" if ticks > 0 else "-"
    subprocess.run(["brightnessctl", "-e4", "-n2", "-q", "set", f"{abs(ticks) * BRIGHTNESS_STEP}%{sign}"])
    subprocess.run(["qs", "-c", "hypr-shell", "ipc", "call", "osd", "brightness"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def volume(ticks):
    sign = "+" if ticks > 0 else "-"
    # The shell shows the volume OSD on its own when the sink changes.
    subprocess.run(["wpctl", "set-volume", "-l", "1", "@DEFAULT_AUDIO_SINK@", f"{abs(ticks) * VOLUME_STEP}%{sign}"])


def serve(fd):
    while True:
        select.select([fd], [], [])
        ticks = {LEFT: 0, RIGHT: 0}
        while True:  # drain everything already queued
            try:
                data = os.read(fd, 64)
            except BlockingIOError:
                break
            if not data:
                raise OSError("device gone")
            if len(data) >= 3 and data[0] == REPORT and data[1] in ticks and data[2] in (UP, DOWN):
                ticks[data[1]] += 1 if data[2] == UP else -1
        if ticks[LEFT]:
            brightness(ticks[LEFT])
        if ticks[RIGHT]:
            volume(ticks[RIGHT])


def main():
    warned = False
    while True:  # survive suspend/resume and driver rebinds: reopen when the node returns
        node = find_node()
        if node is None:
            if not warned:
                print(f"hs-edge-slider: no hidraw node for {HID_ID}, waiting", file=sys.stderr)
                warned = True
            time.sleep(5)
            continue
        try:
            fd = os.open(node, os.O_RDONLY | os.O_NONBLOCK)
        except PermissionError:
            sys.exit(f"hs-edge-slider: no access to {node}, install system/70-hypr-shell-touchpad-edge.rules")
        except OSError:
            time.sleep(2)
            continue
        warned = False
        try:
            serve(fd)
        except OSError:
            time.sleep(1)
        finally:
            os.close(fd)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
