#!/bin/sh
# Prints one block of raw system counters every $1 seconds (default 1) until it is killed; the shell turns them into rates.
# Block: tagged lines ("cpu", "mem", "temp", "net", "bat", "gpu", "disk") ended by "---".
# Reads files with shell builtins so a block costs almost no forks.

interval=${1:-1}

temp=""
for h in /sys/class/hwmon/hwmon*; do
    case "$(cat "$h/name" 2>/dev/null)" in coretemp|k10temp) temp="$h/temp1_input"; break ;; esac
done
bat=$(ls -d /sys/class/power_supply/BAT* 2>/dev/null | head -n 1)
gpu=$(ls /sys/class/drm/card*/gt_act_freq_mhz 2>/dev/null | head -n 1)
gpudir=""
[ -n "$gpu" ] && gpudir=$(dirname "$gpu")

echo "cores $(nproc)"
n=0
dev=""
disk=""
while :; do
    if [ $((n % 10)) -eq 0 ]; then
        dev=$(ip route show default 2>/dev/null | awk 'NR==1{print $5}')
        disk=$(df -B1 --output=used,size / 2>/dev/null | tail -n 1)
    fi
    n=$((n + 1))

    read -r line < /proc/stat
    echo "cpu $line"

    mt=0; ma=0; swt=0; swf=0
    while read -r k v _; do
        case $k in
            MemTotal:) mt=$v ;;
            MemAvailable:) ma=$v ;;
            SwapTotal:) swt=$v ;;
            SwapFree:) swf=$v ;;
        esac
    done < /proc/meminfo
    echo "mem $mt $ma $swt $swf"

    if [ -n "$temp" ]; then
        t=0
        { read -r t < "$temp"; } 2>/dev/null
        echo "temp $t"
    fi
    if [ -n "$dev" ]; then
        rx=0; tx=0
        { read -r rx < "/sys/class/net/$dev/statistics/rx_bytes"; read -r tx < "/sys/class/net/$dev/statistics/tx_bytes"; } 2>/dev/null
        echo "net $rx $tx"
    fi
    if [ -n "$bat" ]; then
        cap=0; pw=0; vo=0; cu=0; bs=""
        { read -r cap < "$bat/capacity"; } 2>/dev/null
        { read -r pw < "$bat/power_now"; } 2>/dev/null
        { read -r vo < "$bat/voltage_now"; } 2>/dev/null
        { read -r cu < "$bat/current_now"; } 2>/dev/null
        { read -r bs < "$bat/status"; } 2>/dev/null
        echo "bat $cap $pw $vo $cu $bs"
    fi
    if [ -n "$gpu" ]; then
        g=0; gm=1
        { read -r g < "$gpu"; read -r gm < "$gpudir/gt_max_freq_mhz"; } 2>/dev/null
        echo "gpu $g $gm"
    fi
    echo "disk $disk"
    echo "---"
    sleep "$interval"
done
