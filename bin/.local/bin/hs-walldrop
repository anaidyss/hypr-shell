#!/usr/bin/env python3
"""Apply a wallpaper that was dropped on the desktop.

  hs-walldrop file <path>      local image
  hs-walldrop search <thumb>   online search result (downloads the full image first)
  options: --at X Y   use this logical cursor position instead of asking Hyprland
           --dry-run  print the decision and do nothing

The drop counts only when nothing but the desktop is under the cursor: dropping on a window does
nothing. The settings window closes and the transition circle grows from the drop point.
"""
import json
import os
import subprocess
import sys


def hypr(*args):
    out = subprocess.run(["hyprctl", *args, "-j"], capture_output=True, text=True, timeout=3).stdout
    return json.loads(out)


def decide(cx, cy):
    monitors = hypr("monitors")
    mon = next((m for m in monitors if m["x"] <= cx < m["x"] + m["width"] / m["scale"]
                and m["y"] <= cy < m["y"] + m["height"] / m["scale"]), None)
    if mon is None:
        return {"action": "ignore", "reason": "cursor outside every monitor"}

    # Workspaces are compared by name: a special workspace has no "id" in the client list.
    shown = {mon["activeWorkspace"]["name"], mon.get("specialWorkspace", {}).get("name", "")} - {""}
    for c in hypr("clients"):
        if not c["mapped"] or c["hidden"] or c["workspace"]["name"] not in shown:
            continue
        x, y = c["at"]
        w, h = c["size"]
        if x <= cx < x + w and y <= cy < y + h:
            return {"action": "ignore", "reason": "over window " + c["class"]}

    pw, ph = mon["width"], mon["height"]
    if mon["transform"] % 2:
        pw, ph = ph, pw
    fx = (cx - mon["x"]) / (pw / mon["scale"])
    fy = (cy - mon["y"]) / (ph / mon["scale"])
    # awww counts integer positions in pixels from the left and from the bottom
    pos = "%d,%d" % (round(fx * pw), round((1 - fy) * ph))
    return {"action": "apply", "pos": pos, "monitor": mon["name"]}


def main(argv):
    dry = "--dry-run" in argv
    argv = [a for a in argv if a != "--dry-run"]
    at = None
    if "--at" in argv:
        i = argv.index("--at")
        at = (float(argv[i + 1]), float(argv[i + 2]))
        del argv[i:i + 3]
    if len(argv) != 2 or argv[0] not in ("file", "search"):
        print(__doc__, file=sys.stderr)
        return 2

    if at is None:
        cur = hypr("cursorpos")
        at = (cur["x"], cur["y"])
    result = decide(*at)
    if dry or result["action"] != "apply":
        print(json.dumps(result))
        return 0

    env = dict(os.environ)
    env["HS_TRANSITION_POS"] = result["pos"]
    env["PATH"] = os.path.expanduser("~/.local/bin") + ":" + env.get("PATH", "")
    subprocess.Popen(["qs", "-c", "hypr-shell", "ipc", "call", "settings", "close"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    tool = ["hs-wallset", argv[1]] if argv[0] == "file" else ["hs-wallsearch", "apply", argv[1]]
    return subprocess.run(tool, env=env).returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
