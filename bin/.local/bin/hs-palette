#!/usr/bin/env python3
"""Extract distinct accent colors from the wallpaper.

Reads the wallpaper path from ~/.local/state/hypr-shell/wallpaper (or argv[1]) and the main accent
(primary) from colors.json, then writes wallpalette.json with up to MAX_EXTRA more colors: the
other hues that really occur in the picture (sky, trees, ...), strongest first, each at least
MIN_SEPARATION degrees of hue away from the accent and from each other. Each color is re-rendered at
the accent's lightness so it reads on the panel like the accent does.
The interface uses the first one as its secondary accent (theme.json accents.count).
"""
import json
import math
import os
import sys

from PIL import Image

HOME = os.path.expanduser("~")
STATE = os.path.join(HOME, ".local", "state", "hypr-shell")
MAX_EXTRA = 2
MIN_SEPARATION = 38.0
BINS = 72
MIN_SHARE = 0.05


def to_linear(c):
    c /= 255.0
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def to_srgb(c):
    c = max(0.0, min(1.0, c))
    return 255 * (12.92 * c if c <= 0.0031308 else 1.055 * c ** (1 / 2.4) - 0.055)


def to_lch(rgb):
    r, g, b = (to_linear(v) for v in rgb)
    l = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b) ** (1 / 3)
    m = (0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b) ** (1 / 3)
    s = (0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b) ** (1 / 3)
    L = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s
    a = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s
    bb = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s
    return L, math.hypot(a, bb), math.degrees(math.atan2(bb, a)) % 360


def to_hex(L, C, hue_deg):
    hue = math.radians(hue_deg)
    for _ in range(30):
        a, b = C * math.cos(hue), C * math.sin(hue)
        l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3
        m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3
        s = (L - 0.0894841775 * a - 1.2914855480 * b) ** 3
        rgb = (
            4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
            -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
            -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s,
        )
        if all(-0.0005 <= v <= 1.0005 for v in rgb):
            break
        C *= 0.9
    return "#%02x%02x%02x" % tuple(round(to_srgb(v)) for v in rgb)


def hue_dist(a, b):
    d = abs(a - b) % 360
    return min(d, 360 - d)


def hex_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def write(colors):
    os.makedirs(STATE, exist_ok=True)
    tmp = os.path.join(STATE, "wallpalette.json.tmp")
    with open(tmp, "w") as f:
        json.dump({"colors": colors}, f, indent=2)
    os.replace(tmp, os.path.join(STATE, "wallpalette.json"))


def main():
    path = sys.argv[1] if len(sys.argv) > 1 else ""
    if not path:
        try:
            path = open(os.path.join(STATE, "wallpaper")).read().strip()
        except OSError:
            path = ""
    try:
        colors = json.load(open(os.path.join(STATE, "colors.json")))
        accent_l, accent_c, accent_h = to_lch(hex_rgb(colors["primary"]))
        img = Image.open(path)
    except Exception:
        write([])
        return
    img.draft("RGB", (320, 320))
    img = img.convert("RGB")
    img.thumbnail((160, 160))
    px = list(getattr(img, "get_flattened_data", img.getdata)())

    # Hue histogram by area, lightly favoring vivid pixels (sqrt of chroma): muted skies and dark forests
    # are real colors of a picture even though their chroma is tiny.
    weights = [0.0] * BINS
    chroma_sum = [0.0] * BINS
    count = [0] * BINS
    total = 0.0
    for p in px:
        L, C, H = to_lch(p)
        if C < 0.012 or L < 0.12 or L > 0.97:
            continue
        w = math.sqrt(C)
        i = int(H / 360 * BINS) % BINS
        weights[i] += w
        chroma_sum[i] += C
        count[i] += 1
        total += w
    if total <= 0:
        write([])
        return

    smooth = [sum(weights[(i + d) % BINS] for d in (-2, -1, 0, 1, 2)) for i in range(BINS)]
    bin_deg = 360 / BINS
    chosen = [accent_h]
    out = []
    while len(out) < MAX_EXTRA:
        best, best_w = -1, 0.0
        for i in range(BINS):
            h = (i + 0.5) * bin_deg
            if any(hue_dist(h, c) < MIN_SEPARATION for c in chosen):
                continue
            if smooth[i] > best_w:
                best, best_w = i, smooth[i]
        if best < 0 or best_w < total * MIN_SHARE:
            break
        # Circular mean hue and mean chroma around the peak.
        sx = sy = sw = cs = cn = 0.0
        for d in range(-3, 4):
            j = (best + d) % BINS
            w = weights[j]
            ang = math.radians((j + 0.5) * bin_deg)
            sx += w * math.cos(ang)
            sy += w * math.sin(ang)
            sw += w
            cs += chroma_sum[j]
            cn += count[j]
        hue = math.degrees(math.atan2(sy, sx)) % 360
        mean_c = cs / cn if cn else 0.1
        # Muted source colors are brought up to a chroma that reads on the panel.
        chroma = max(0.09, min(max(accent_c, 0.12), mean_c * 3.0))
        out.append(to_hex(accent_l, chroma, hue))
        chosen.append(hue)
        for d in range(-4, 5):
            smooth[(best + d) % BINS] = 0.0
    write(out)


main()
