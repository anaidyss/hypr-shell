#!/usr/bin/env python3
# Clipboard history helper for the shell (a thin layer over cliphist).
#   hs-clip list [N]     newest first, one JSON object per line: {id, kind, title, meta[, color]}
#   hs-clip text ID      the entry as text (cut to 4000 characters)
#   hs-clip image ID     decodes an image entry to the runtime dir and prints its path
#   hs-clip copy ID      puts the entry back on the clipboard
#   hs-clip delete ID    removes one entry
#   hs-clip clear        removes everything

import json
import os
import re
import subprocess
import sys
import time

CACHE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "hs-clip")


def run(args, data=None):
    return subprocess.run(args, input=data, capture_output=True, check=False)


def decode(entry_id):
    return run(["cliphist", "decode", entry_id]).stdout


def sniff(data):
    if data.startswith(b"\x89PNG"):
        return "png", "image/png"
    if data.startswith(b"\xff\xd8"):
        return "jpg", "image/jpeg"
    if data.startswith(b"BM"):
        return "bmp", "image/bmp"
    if data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        return "webp", "image/webp"
    return None, None


def color_of(text):
    t = text.strip()
    m = re.fullmatch(r"#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})", t)
    if m:
        h = m.group(1).lower()
        if len(h) == 3:
            h = "".join(c * 2 for c in h)
        # CSS puts alpha last, QML first.
        return "#" + (h[6:] + h[:6] if len(h) == 8 else h)
    m = re.fullmatch(r"rgba?\(\s*(\d{1,3})\s*[, ]\s*(\d{1,3})\s*[, ]\s*(\d{1,3})\s*(?:[,/]\s*([0-9.]+%?)\s*)?\)", t)
    if m:
        r, g, b = (min(255, int(m.group(i))) for i in (1, 2, 3))
        a = 1.0
        if m.group(4):
            a = float(m.group(4).rstrip("%")) / (100 if m.group(4).endswith("%") else 1)
        a = max(0, min(1, a))
        return "#%02x%02x%02x%02x" % (round(a * 255), r, g, b) if a < 1 else "#%02x%02x%02x" % (r, g, b)
    return None


def prune():
    try:
        for name in os.listdir(CACHE):
            path = os.path.join(CACHE, name)
            if time.time() - os.path.getmtime(path) > 3600:
                os.remove(path)
    except OSError:
        pass


def cmd_list(limit):
    prune()
    out = run(["cliphist", "list"]).stdout.decode("utf-8", "replace")
    n = 0
    for line in out.splitlines():
        if n >= limit:
            break
        entry_id, _, preview = line.partition("\t")
        if not entry_id.isdigit():
            continue
        item = {"id": entry_id}
        m = re.fullmatch(r"\[\[ binary data (.+?) (\w+) (\d+x\d+) \]\]", preview)
        if m:
            item.update(kind="image", title="Image", meta="%s %s · %s" % (m.group(2).upper(), m.group(3), m.group(1)))
        else:
            text = " ".join(preview.split())
            if text == "":
                continue
            col = color_of(text) if len(text) <= 40 else None
            if col:
                item.update(kind="color", title=text, meta="Color", color=col)
            else:
                item.update(kind="text", title=text[:140], meta="")
        print(json.dumps(item, ensure_ascii=False))
        n += 1


def cmd_text(entry_id):
    sys.stdout.write(decode(entry_id).decode("utf-8", "replace")[:4000])


def cmd_image(entry_id):
    os.makedirs(CACHE, exist_ok=True)
    for ext in ("png", "jpg", "bmp", "webp"):
        path = os.path.join(CACHE, "%s.%s" % (entry_id, ext))
        if os.path.exists(path):
            print(path)
            return
    data = decode(entry_id)
    ext, _ = sniff(data)
    if not ext:
        return
    path = os.path.join(CACHE, "%s.%s" % (entry_id, ext))
    with open(path, "wb") as f:
        f.write(data)
    print(path)


def cmd_copy(entry_id):
    data = decode(entry_id)
    _, mime = sniff(data)
    args = ["wl-copy", "-t", mime] if mime else ["wl-copy"]
    subprocess.run(args, input=data, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


def cmd_delete(entry_id):
    run(["cliphist", "delete"], ("%s\t\n" % entry_id).encode())


def main():
    a = sys.argv[1:]
    if not a:
        sys.exit(2)
    if a[0] == "list":
        cmd_list(int(a[1]) if len(a) > 1 else 200)
    elif a[0] == "clear":
        run(["cliphist", "wipe"])
    elif len(a) > 1 and a[1].isdigit():
        {"text": cmd_text, "image": cmd_image, "copy": cmd_copy, "delete": cmd_delete}[a[0]](a[1])
    else:
        sys.exit(2)


main()
