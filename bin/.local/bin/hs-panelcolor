#!/usr/bin/env python3
"""Picks the panel color and opacity that suit a wallpaper.

Usage: hs-panelcolor <image> [--print]
Writes ~/.local/state/hypr-shell/panel.json, which the shell watches.

The panel sits at the lightness of the terminal background (the interface uses light text) with only a faint
tint of the wallpaper's hue. Opacity comes from the shared
glass opacity (the same as the terminal's); this script only reports the lowest opacity that keeps light icons
readable over a bright picture ("floor").
"""
import json
import math
import os
import sys

from PIL import Image

STATE = os.path.join(os.path.expanduser("~"), ".local", "state", "hypr-shell")


def to_linear(c):
    c /= 255.0
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def to_srgb(c):
    c = max(0.0, min(1.0, c))
    return 255.0 * (12.92 * c if c <= 0.0031308 else 1.055 * c ** (1 / 2.4) - 0.055)


def oklab(r, g, b):
    r, g, b = to_linear(r), to_linear(g), to_linear(b)
    l = (0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b) ** (1 / 3)
    m = (0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b) ** (1 / 3)
    s = (0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b) ** (1 / 3)
    return (
        0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
        1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
        0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s,
    )


def linear_rgb(L, a, b):
    l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3
    m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3
    s = (L - 0.0894841775 * a - 1.2914855480 * b) ** 3
    return (
        4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
        -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
        -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s,
    )


def to_hex(L, chroma, hue):
    # Pull the chroma in until the color fits into sRGB.
    for _ in range(24):
        rgb = linear_rgb(L, chroma * math.cos(hue), chroma * math.sin(hue))
        if all(-0.0005 <= v <= 1.0005 for v in rgb):
            break
        chroma *= 0.85
    return "#%02x%02x%02x" % tuple(round(to_srgb(v)) for v in rgb)


def clamp(v, lo, hi):
    return max(lo, min(hi, v))


def analyze(path):
    im = Image.open(path)
    im.draft("RGB", (400, 400))
    im = im.convert("RGB")
    im.thumbnail((200, 200))
    w, h = im.size
    px = list(getattr(im, "get_flattened_data", im.getdata)())
    lab = [oklab(*p) for p in px]
    band = max(1, int(w * 0.08))
    left = [lab[y * w + x] for y in range(h) for x in range(band)]

    def mean(items, i):
        return sum(v[i] for v in items) / len(items)

    # The strip on the left is the most visible part of the panel, so its picture counts as much as the rest.
    L = 0.5 * mean(left, 0) + 0.5 * mean(lab, 0)
    a = 0.5 * mean(left, 1) + 0.5 * mean(lab, 1)
    b = 0.5 * mean(left, 2) + 0.5 * mean(lab, 2)
    ls = sorted(v[0] for v in lab)
    avg = sum(ls) / len(ls)
    sigma = math.sqrt(sum((v - avg) ** 2 for v in ls) / len(ls))
    high = ls[int(len(ls) * 0.9)]
    return L, a, b, sigma, high


def terminal_lightness():
    """Lightness of the terminal background, so the panel sits on the same level."""
    surface = "#171719"
    try:
        with open(os.path.join(os.path.expanduser("~"), ".config", "hypr-shell", "theme.json")) as f:
            surface = json.load(f)["palette"]["surface"]
    except (OSError, KeyError, ValueError):
        pass
    c = surface.lstrip("#")
    return oklab(*(int(c[i:i + 2], 16) for i in (0, 2, 4)))[0]


def choose(L, a, b, sigma, high):
    chroma = math.hypot(a, b)
    hue = math.atan2(b, a)
    base = terminal_lightness()
    panel_l = clamp(base + 0.04 * (L - 0.3), base - 0.01, base + 0.02)
    # Only a faint tint of the wallpaper's hue: a strong one makes the panel look unlike the terminal.
    tint = clamp(chroma * 0.12, 0.0, 0.012) * clamp(L / 0.25, 0.3, 1.0)
    color = to_hex(panel_l, tint, hue)

    # Bright picture behind the panel: it must stay dark enough for light icons after blending.
    floor = 0.0
    if high > 0.34:
        floor = (high - 0.34) / max(0.05, high - panel_l)
    return color, round(clamp(floor, 0.0, 1.0), 2)


def main():
    if len(sys.argv) < 2:
        sys.exit("usage: hs-panelcolor <image> [--print]")
    L, a, b, sigma, high = analyze(sys.argv[1])
    color, floor = choose(L, a, b, sigma, high)
    result = {
        "color": color,
        "floor": floor,
        "wallpaper": os.path.abspath(sys.argv[1]),
        "stats": {"lightness": round(L, 3), "chroma": round(math.hypot(a, b), 3), "contrast": round(sigma, 3), "bright": round(high, 3)},
    }
    if "--print" in sys.argv:
        print(json.dumps(result))
        return
    os.makedirs(STATE, exist_ok=True)
    tmp = os.path.join(STATE, "panel.json.tmp")
    with open(tmp, "w") as f:
        json.dump(result, f, indent=2)
    os.replace(tmp, os.path.join(STATE, "panel.json"))


main()
