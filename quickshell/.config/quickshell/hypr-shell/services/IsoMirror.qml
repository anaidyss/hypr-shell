pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io
import qs.theme
import "../data/distros.js" as Distros

// Images from the TUNA mirror (falling back to BFSU, NJU, USTC): `hs-flash catalog` reads the mirror's own list of
// current images (isoinfo.json, regenerated by the mirror on every release, cached 12 h), so links never go stale.
// The library asks `newest(item)` to mark images that have a newer release, and downloads run one at a time here
// (queued, resumable, checked against the checksum the mirror publishes) into the ISO folder.
Singleton {
    id: root

    property bool wanted: false
    property var entries: []
    property bool loaded: false
    property string error: ""
    property bool stale: false

    onWantedChanged: if (wanted && !catalogProc.running) load(false)
    function load(force) {
        catalogProc.command = ["hs-flash", "catalog"].concat(force ? ["refresh"] : [])
        catalogProc.running = true
    }

    Process {
        id: catalogProc
        stdout: StdioCollector {
            onStreamFinished: {
                let r = { ok: false, entries: [], msg: "Mirror unreachable" }
                try { r = JSON.parse(text) } catch (e) {}
                root.error = r.ok ? "" : (r.msg || "Mirror unreachable")
                root.stale = !!r.stale
                if (r.ok) root.entries = r.entries
                root.loaded = true
            }
        }
    }

    // ---- versions ----
    // "26.04.1" vs "26.10", "2026.11.01" vs "2026.04.27", "4.3.2-rc1": numbers compared left to right.
    function cmp(a, b) {
        const x = (a.match(/\d+/g) || []).map(Number), y = (b.match(/\d+/g) || []).map(Number)
        for (let i = 0; i < Math.max(x.length, y.length); i++) {
            const d = (x[i] || 0) - (y[i] || 0)
            if (d !== 0) return d
        }
        return 0
    }
    // Same separate release lines as hs-flash's track_of: LMDE, Ubuntu Core / Kylin / GNOME, Proxmox products, Leap.
    function trackOf(file) {
        const t = file.toLowerCase()
        const rules = [["lmde", "lmde"], ["core", "ubuntu-core"], ["kylin", "kylin"], ["gnome", "ubuntu-gnome"],
            ["mail", "mail-gateway"], ["backup", "backup-server"], ["leap", "leap"]]
        for (const r of rules) if (t.indexOf(r[1]) >= 0) return r[0]
        return ""
    }
    function isLts(id, version) {
        return /^\d*[02468]\.04/.test(version) && ["ubuntu", "kubuntu", "xubuntu", "lubuntu", "ubuntumate"].indexOf(id) >= 0
    }

    // The newest stable release on the line of a library image, or null when the mirror does not carry it.
    // An Ubuntu LTS is compared with LTS releases only.
    function newest(item) {
        if (!item.version || !/\d/.test(item.version)) return null
        const track = trackOf(item.file)
        const lts = isLts(item.distro, item.version)
        let best = null
        for (const e of entries) {
            if (e.id !== item.distro || e.track !== track || e.pre || !/\d/.test(e.version)) continue
            if (lts && !e.lts) continue
            if (best === null || cmp(e.version, best.version) > 0) best = e
        }
        return best
    }

    // Of the newest release, the variant closest to the local file (desktop vs server, xfce vs cinnamon…).
    function norm(f) { return f.toLowerCase().replace(/\d+([._-]\d+)*/g, "#").replace(/\.(iso|img)(\.\w+)?$/, "") }
    function updateFor(item) {
        const top = newest(item)
        if (!top || cmp(top.version, item.version) <= 0) return null
        const mine = norm(item.file), words = mine.split(/[-_.#]+/).filter(w => w.length > 1)
        let best = null, score = -1
        for (const e of entries) {
            if (e.id !== top.id || e.track !== top.track || e.version !== top.version || e.pre) continue
            const n = norm(e.file)
            const s = n === mine ? 1000 : words.filter(w => n.indexOf(w) >= 0).length
            if (s > score) { best = e; score = s }
        }
        return best
    }

    // ---- browsing ----
    // One row per distribution: newest stable version and how many images it has.
    readonly property var groups: {
        const by = {}
        for (const e of entries) {
            const g = by[e.id] || (by[e.id] = { id: e.id, count: 0, latest: "" })
            g.count++
            if (!e.pre && /\d/.test(e.version) && (g.latest === "" || cmp(e.version, g.latest) > 0)) g.latest = e.version
        }
        return Object.values(by).map(g => {
            const d = Distros.byId(g.id) || Distros.byId("linux")
            return Object.assign(g, { name: d.name, logo: d.path })
        }).sort((a, b) => a.name.localeCompare(b.name))
    }
    function variants(id) {
        return entries.filter(e => e.id === id).slice().sort((a, b) => cmp(b.version, a.version) || a.label.localeCompare(b.label))
    }
    // "26.10 (amd64, Desktop LiveDVD)" -> "Desktop LiveDVD"; the version is shown on its own.
    function variantName(e) {
        const m = /\(([^)]*)\)/.exec(e.label)
        const inner = m ? m[1].split(",").map(s => s.trim()).filter(s => !/^(amd64|x86_64|x64|64bit|iso)$/i.test(s)) : []
        const head = e.label.split(" (")[0].replace(e.version, "").trim()
        return [head].concat(inner).filter(s => s !== "").join(" · ") || e.file
    }
    function title(e) {
        const d = Distros.byId(e.id) || Distros.byId("linux")
        return d.name + (e.version !== "" ? " " + e.version : "")
    }

    // ---- downloads ----
    property var queue: []
    property var current: null
    property string dlStage: ""
    property string dlLabel: ""
    property real dlDone: 0
    property real dlTotal: 0
    property real dlSpeed: 0
    property string dlError: ""
    readonly property bool downloading: dlProc.running
    readonly property real dlRatio: dlTotal > 0 ? Math.min(1, dlDone / dlTotal) : 0

    function queued(e) {
        return (current !== null && current.path === e.path && dlProc.running) || queue.some(q => q.path === e.path)
    }
    function download(e) {
        if (queued(e)) return
        queue = queue.concat([e])
        next()
    }
    function next() {
        if (dlProc.running || queue.length === 0) return
        current = queue[0]
        queue = queue.slice(1)
        dlStage = "prepare"
        dlLabel = "Starting"
        dlDone = 0
        dlTotal = 0
        dlSpeed = 0
        dlError = ""
        dlProc.command = ["hs-flash", "download", current.path, IsoLibrary.dir, current.version]
        dlProc.running = true
    }
    // Stops the download; the .part stays and the next try continues from it.
    function cancel() {
        queue = []
        if (dlProc.running) dlProc.signal(15)
    }
    function dismiss() { if (!dlProc.running) { dlStage = ""; dlError = ""; current = null } }

    Process {
        id: dlProc
        stdout: SplitParser {
            onRead: line => {
                let r = {}
                try { r = JSON.parse(line) } catch (e) { return }
                if (r.total !== undefined) root.dlTotal = r.total
                if (r.done !== undefined) root.dlDone = r.done
                if (r.speed !== undefined) root.dlSpeed = r.speed
                if (r.label !== undefined) root.dlLabel = r.label
                if (r.stage === "error") root.dlError = r.msg || "Download failed"
                if (r.stage) root.dlStage = r.stage
                if (r.stage === "done")
                    Quickshell.execDetached(["notify-send", "-a", "Drives", "Downloaded " + root.title(root.current), r.result || ""])
                else if (r.stage === "error" && !/^Paused/.test(r.msg || ""))
                    Quickshell.execDetached(["notify-send", "-a", "Drives", "-u", "critical", root.title(root.current), root.dlError])
            }
        }
        onExited: {
            if (root.dlStage !== "done" && root.dlStage !== "error") {
                root.dlStage = "error"
                root.dlError = "The download stopped unexpectedly"
            }
            IsoLibrary.rescan()
            if (root.dlStage === "done") {
                root.dlStage = ""
                root.current = null
            }
            root.next()
        }
    }
}
